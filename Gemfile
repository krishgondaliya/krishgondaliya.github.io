source "https://rubygems.org"

# Match the Jekyll version supported by GitHub Pages branch publishing.
gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm", "~> 1.1"
gem "webrick", "~> 1.8"

# Windows does not ship with the timezone database.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end
